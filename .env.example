# Copy to .env and fill in. .env is gitignored and is the ONLY file that may hold secrets.

# Anthropic API key for the five agents
ANTHROPIC_API_KEY=

# Text-to-speech (ElevenLabs). The voice id goes in config.yaml, not here.
ELEVENLABS_API_KEY=

# Path to the OAuth client secret JSON you downloaded from Google Cloud (desktop app).
# Keep the file in this folder; it is gitignored.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# Written by `python -m scripts.auth_youtube`. Do not fill in by hand.
YOUTUBE_REFRESH_TOKEN=

# Optional: a webhook (Discord, Slack incoming webhook, ntfy, ...) that receives owner alerts.
NOTIFY_WEBHOOK_URL=
